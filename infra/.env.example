# Use this file as template for .env

###################
# POSTGRESQL VARS #
###################

POSTGRES_DB_PASSWORD=changeme


#################
# KEYCLOAK VARS #
#################

KEYCLOAK_DB_PASSWORD=change-me-db

# Admin of realm "master" de Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-master

# Services clients secrets (ex: openssl rand -hex 32)
CUSTOMER_REGISTRATION_SECRET=change-me-customer-registration
IDENTITY_SERVICE_SECRET=change-me-identity-service


##############
# ADMIN VARS #
##############

# First admin user (used by keycloak/bootstrap-admin.sh)
ADMIN_FIRST_USER_EMAIL=admin@example.com
ADMIN_FIRST_USER_TEMP_PASSWORD=changeMe01#000


##############
# SHOP VARS #
##############

SHOP_DB_PASSWORD=changeme